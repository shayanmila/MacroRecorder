<Window x:Class="MasoomDev.MacroRecorder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Masoom Macro Recorder" Width="940" Height="760" MinWidth="730" MinHeight="580" WindowStartupLocation="CenterScreen" Background="White" Closing="OnWindowClosing">
 <DockPanel Margin="20">
  <Border DockPanel.Dock="Top" Background="#F7F3FB" Padding="18" CornerRadius="12" Margin="0,0,0,12">
   <StackPanel><TextBlock Text="Macro Recorder" FontFamily="Segoe UI" FontSize="29" FontWeight="Bold" Foreground="#7540AC"/><TextBlock Text="Made by MasoomDev · Windows Desktop" FontSize="14" Foreground="#566075"/></StackPanel>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#F7F3FB"><StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="EventsText" Text="Events: 0"/></StatusBarItem><Separator/><StatusBarItem><TextBlock Text="F8 Emergency Stop · F9 Pause / Resume"/></StatusBarItem></StatusBar>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <GroupBox Header="Recording Options"><StackPanel Orientation="Horizontal"><CheckBox x:Name="MouseCheck" Content="Record mouse activity" Margin="10" IsChecked="True"/><CheckBox x:Name="KeyboardCheck" Content="Record keyboard activity" Margin="10" IsChecked="True"/><CheckBox x:Name="MovementCheck" Content="Sample mouse movements" Margin="10" IsChecked="True"/></StackPanel></GroupBox>
   <GroupBox Header="Recorder Controls"><WrapPanel><Button Content="● Start Recording" Click="StartRecording_Click"/><Button Content="■ Stop Recording" x:Name="StopRecordButton" IsEnabled="False" Click="StopRecording_Click"/><Button Content="Clear" Click="Clear_Click"/><Button Content="Save JSON" Click="Save_Click"/><Button Content="Load JSON" Click="Load_Click"/><Button x:Name="PlayButton" Content="▶ Play" Click="Play_Click"/><Button x:Name="PauseButton" Content="⏸ Pause" IsEnabled="False" Click="Pause_Click"/><Button x:Name="StopPlayButton" Content="■ Stop Playback" IsEnabled="False" Click="StopPlayback_Click"/></WrapPanel></GroupBox>
   <GroupBox Header="Playback Settings"><WrapPanel VerticalAlignment="Center"><TextBlock Text="Repeat count" VerticalAlignment="Center" Margin="8"/><TextBox x:Name="RepeatCount" Text="1" Width="60"/><TextBlock Text="Repeat minutes (overrides count)" VerticalAlignment="Center" Margin="8"/><TextBox x:Name="RepeatMinutes" Text="0" Width="60"/><TextBlock Text="Speed" VerticalAlignment="Center" Margin="8"/><ComboBox x:Name="SpeedCombo" SelectedIndex="2" Width="90" Margin="5"><ComboBoxItem Content="0.5x" Tag="0.5"/><ComboBoxItem Content="0.75x" Tag="0.75"/><ComboBoxItem Content="1x" Tag="1"/><ComboBoxItem Content="1.5x" Tag="1.5"/><ComboBoxItem Content="2x" Tag="2"/></ComboBox></WrapPanel></GroupBox>
   <GroupBox Header="Recorded Events"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Review your recorded mouse and keyboard actions before playback. Saved JSON may contain typed text; keep it private." Foreground="#677083" TextWrapping="Wrap" Margin="0,0,0,8"/><ListBox x:Name="EventList" Height="260" FontFamily="Consolas" FontSize="12" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/></DockPanel></GroupBox>
   <TextBlock Text="Only record and replay actions on systems you control or are authorised to operate. Hotkeys work while the application is running." TextWrapping="Wrap" Foreground="#667085" Margin="4,10"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>