<Window x:Class="MasoomDev.MacroRecorder.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Masoom Macro Recorder" Width="720" Height="545" MinWidth="540" MinHeight="400"
 ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
 Background="White" Closing="OnWindowClosing" FontFamily="Segoe UI" FontSize="12"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="0,0,0,7"/>
   <Setter Property="Padding" Value="7,4"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="MinWidth" Value="50"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="5,3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="4,1"/><Setter Property="Padding" Value="4"/></Style>
 </Window.Resources>
 <DockPanel Margin="10">
  <Border DockPanel.Dock="Top" Background="#F7F3FB" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
   <DockPanel>
    <TextBlock DockPanel.Dock="Right" Text="Made by MasoomDev" VerticalAlignment="Center" Foreground="#566075" FontSize="11" Margin="8,0,0,0"/>
    <TextBlock Text="Macro Recorder" FontSize="20" FontWeight="SemiBold" Foreground="#7540AC" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#F7F3FB" Padding="2,0">
   <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis" MaxWidth="210"/></StatusBarItem>
   <Separator/>
   <StatusBarItem><TextBlock x:Name="EventsText" Text="Events: 0"/></StatusBarItem>
   <Separator/>
   <StatusBarItem><TextBlock Text="F8 Stop · F9 Pause" FontSize="11"/></StatusBarItem>
  </StatusBar>
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="5"/>
    <RowDefinition Height="*" MinHeight="90"/>
   </Grid.RowDefinitions>
   <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="76">
    <GroupBox Header="Recording Options">
     <WrapPanel>
      <CheckBox x:Name="MouseCheck" Content="Mouse" IsChecked="True"/>
      <CheckBox x:Name="KeyboardCheck" Content="Keyboard" IsChecked="True"/>
      <CheckBox x:Name="MovementCheck" Content="Sample movement" IsChecked="True"/>
     </WrapPanel>
    </GroupBox>
   </ScrollViewer>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="155">
    <GroupBox Header="Controls">
     <WrapPanel>
      <Button Content="● Record" Click="StartRecording_Click"/>
      <Button x:Name="StopRecordButton" Content="■ Stop" IsEnabled="False" Click="StopRecording_Click"/>
      <Button x:Name="PlayButton" Content="▶ Play" Click="Play_Click"/>
      <Button x:Name="PauseButton" Content="⏸ Pause" IsEnabled="False" Click="Pause_Click"/>
      <Button x:Name="StopPlayButton" Content="■ Stop Play" IsEnabled="False" Click="StopPlayback_Click"/>
      <Button Content="Save" Click="Save_Click"/>
      <Button Content="Load" Click="Load_Click"/>
      <Button Content="Clear" Click="Clear_Click"/>
      <Button Content="Delete" Click="DeleteSelected_Click"/>
      <Button Content="↑ Up" Click="MoveUp_Click"/>
      <Button Content="↓ Down" Click="MoveDown_Click"/>
      <Button x:Name="ThemeButton" Content="Dark Theme" Click="ToggleTheme_Click"/>
     </WrapPanel>
    </GroupBox>
   </ScrollViewer>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="95">
    <GroupBox Header="Playback Settings">
     <WrapPanel>
      <TextBlock Text="Repeats" VerticalAlignment="Center" Margin="5,0"/>
      <TextBox x:Name="RepeatCount" Text="1" Width="45"/>
      <TextBlock Text="Minutes" VerticalAlignment="Center" Margin="5,0"/>
      <TextBox x:Name="RepeatMinutes" Text="0" Width="45"/>
      <TextBlock Text="Speed" VerticalAlignment="Center" Margin="5,0"/>
      <ComboBox x:Name="SpeedCombo" SelectedIndex="2" Width="75" Margin="4">
       <ComboBoxItem Content="0.5x" Tag="0.5"/>
       <ComboBoxItem Content="0.75x" Tag="0.75"/>
       <ComboBoxItem Content="1x" Tag="1"/>
       <ComboBoxItem Content="1.5x" Tag="1.5"/>
       <ComboBoxItem Content="2x" Tag="2"/>
      </ComboBox>
     </WrapPanel>
    </GroupBox>
   </ScrollViewer>
   <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDD3E8" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="Drag to resize event log"/>
   <GroupBox Grid.Row="4" Header="Recorded Events" Margin="0,2,0,0">
    <Grid>
     <ListBox x:Name="EventList" FontFamily="Consolas" FontSize="11"
       ScrollViewer.HorizontalScrollBarVisibility="Auto"
       ScrollViewer.VerticalScrollBarVisibility="Auto"
       VirtualizingPanel.IsVirtualizing="True"
       VirtualizingPanel.VirtualizationMode="Recycling"/>
    </Grid>
   </GroupBox>
  </Grid>
 </DockPanel>
</Window>